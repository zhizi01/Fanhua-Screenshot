{
  "name": "fanhua-screenshot",
  "version": "1.0.0",
  "private": true,
  "description": "繁花有图 · 轻盈、自在的桌面截图与标注工具",
  "author": "繁花有图",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "cn.fanhua.screenshot",
    "productName": "繁花有图",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asarUnpack": ["electron/native/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "artifactName": "Fanhua-Screenshot-${version}-Setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "繁花有图", "language": "2052" }
  }
}
