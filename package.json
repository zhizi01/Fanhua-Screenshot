{
  "name": "fanhua-screenshot",
  "version": "1.3.0",
  "private": true,
  "description": "繁花有图 · 轻盈、自在的桌面截图与标注工具",
  "author": "繁花有图",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:translation": "node scripts/verify-translation.cjs",
    "test:translation:service": "node scripts/verify-translation-service.cjs",
    "test:translation:offline": "node scripts/verify-translation-inference.cjs",
    "models:prepare": "node scripts/prepare-translation-models.mjs",
    "models:check": "node scripts/prepare-translation-models.mjs --check",
    "pack": "npm run models:check && npm run build && electron-builder --dir",
    "dist": "npm run models:check && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ant-design-vue": "^4.2.6",
    "lucide-vue-next": "^1.0.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "cn.fanhua.screenshot",
    "productName": "繁花有图",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/@huggingface/transformers/dist/transformers.web*",
      "!node_modules/@huggingface/transformers/dist/transformers.node.mjs*",
      "!node_modules/@huggingface/transformers/dist/*.map"
    ],
    "asarUnpack": [
      "electron/native/**/*",
      "electron/ocr-worker.cjs",
      "electron/translation-worker.cjs",
      "electron/translation-text.cjs",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/idb-keyval/**/*",
      "node_modules/is-url/**/*",
      "node_modules/node-fetch/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/wasm-feature-detect/**/*",
      "node_modules/zlibjs/**/*",
      "node_modules/whatwg-url/**/*",
      "node_modules/tr46/**/*",
      "node_modules/webidl-conversions/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      },
      {
        "from": "resources/translation",
        "to": "translation",
        "filter": ["**/*", "!**/*.partial", "!**/*.tmp"]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Fanhua-Screenshot-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "繁花有图",
      "language": "2052"
    }
  }
}
