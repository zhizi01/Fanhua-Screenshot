{
  "name": "fanhua-screenshot",
  "version": "0.26.1",
  "private": true,
  "os": [
    "win32"
  ],
  "description": "繁花有图 · 轻盈、自在的桌面截图与标注工具",
  "author": "繁花有图",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhizi01/Fanhua-Screenshot.git"
  },
  "homepage": "https://github.com/zhizi01/Fanhua-Screenshot#readme",
  "bugs": {
    "url": "https://github.com/zhizi01/Fanhua-Screenshot/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/windows-target.cjs && npm run pdf:prepare && node scripts/dev.mjs",
    "dev:web": "npm run pdf:prepare && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/windows-target.cjs && npm run pdf:prepare && npm run typecheck && vite build",
    "start": "node scripts/windows-target.cjs && electron .",
    "pdf:prepare": "node scripts/prepare-pdf-assets.mjs",
    "models:prepare": "node scripts/prepare-translation-models.mjs",
    "models:check": "node scripts/prepare-translation-models.mjs --check",
    "pack": "node scripts/windows-target.cjs && npm run models:check && npm run build && electron-builder --win --x64 --dir",
    "dist": "node scripts/windows-target.cjs && npm run models:check && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ant-design-vue": "^4.2.6",
    "lucide-vue-next": "^1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "sharp": "0.34.5",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "cn.fanhua.screenshot",
    "productName": "繁花有图",
    "electronDist": "node_modules/electron/dist",
    "beforePack": "scripts/windows-target.cjs",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/{test,tests,__tests__,fixtures}/**/*",
      "!node_modules/pdfjs-dist/**/*",
      "!node_modules/@napi-rs/canvas*/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/@huggingface/transformers/dist/transformers.web*",
      "!node_modules/@huggingface/transformers/dist/transformers.node.mjs*",
      "!node_modules/@huggingface/transformers/dist/*.map"
    ],
    "asarUnpack": [
      "electron/native/**/*",
      "electron/ocr-worker.cjs",
      "electron/translation-worker.cjs",
      "electron/translation-text.cjs",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/idb-keyval/**/*",
      "node_modules/is-url/**/*",
      "node_modules/node-fetch/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/wasm-feature-detect/**/*",
      "node_modules/zlibjs/**/*",
      "node_modules/whatwg-url/**/*",
      "node_modules/tr46/**/*",
      "node_modules/webidl-conversions/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/Fanhua-MIT.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/ocr",
        "to": "ocr"
      },
      {
        "from": "resources/translation",
        "to": "translation",
        "filter": [
          "**/*",
          "!**/*.partial",
          "!**/*.tmp"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Fanhua-Screenshot-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "繁花有图",
      "language": "2052"
    }
  }
}
